# Copy this file to .env for local development. Never commit the real .env file.

# Port the server listens on (Render sets this automatically in production —
# you don't need to set it there)
PORT=3000

# Comma separated list of allowed frontend origins (no trailing slash).
# Leave blank/unset locally to allow any origin (convenient for local dev).
# Example once deployed: https://your-frontend.netlify.app
CLIENT_ORIGIN=
